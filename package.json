{
  "name": "crwl-on-socialmedia",
  "version": "0.1.5",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Social Media Crawler — Tauri 2 Desktop App (React + Rust Native)",
  "scripts": {
    "dev": "pnpm --filter desktop dev",
    "dev:tauri": "pnpm --filter desktop tauri dev",
    "build": "pnpm --filter desktop build",
    "build:tauri": "pnpm --filter desktop tauri build",
    "lint": "pnpm --filter desktop lint",
    "test:core": "python3 scripts/test_desktop_system.py",
    "repomix": "repomix --config repomix.desktop.config.json && repomix --config repomix.core.config.json",
    "repomix:desktop": "repomix --config repomix.desktop.config.json",
    "repomix:core": "repomix --config repomix.core.config.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "repomix": "^1.18.0"
  }
}
