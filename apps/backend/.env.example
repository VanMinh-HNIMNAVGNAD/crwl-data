PORT=3000
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# ──────────────────────────────────────────────────────────
# Binary Paths (để trống = backend tự tải vào thư mục bin/)
# ──────────────────────────────────────────────────────────
# YT_DLP_PATH=/home/minh/.local/bin/yt-dlp
# GALLERY_DL_PATH=/home/minh/.local/bin/gallery-dl
NODE_PATH=/usr/bin/node

# ──────────────────────────────────────────────────────────
# Cookies & Browser
# Chọn 1 trong: firefox | chrome | chromium | edge | brave | opera | vivaldi | safari | none
# Lưu ý: trình duyệt cần phải ĐÓNG hoàn toàn khi backend đọc cookies (đặc biệt Chrome/Edge)
# ──────────────────────────────────────────────────────────
BROWSER_COOKIES=edge
# COOKIES_PATH=/path/to/cookies.txt   # Nếu set thì ưu tiên hơn BROWSER_COOKIES

# ──────────────────────────────────────────────────────────
# Tính Năng Nâng Cao
# ──────────────────────────────────────────────────────────
# Bật SponsorBlock: tự động bỏ qua sponsor/intro/outro trên YouTube (yêu cầu yt-dlp >= 2023)
ENABLE_SPONSORBLOCK=false

# Nhúng thumbnail (ảnh bìa) vào file MP3/M4A sau khi tải (yêu cầu ffmpeg + AtomicParsley)
EMBED_THUMBNAIL=true

# Nhúng metadata (title, artist, album, uploader) vào file audio
EMBED_METADATA=true

# ──────────────────────────────────────────────────────────
# Giới Hạn & Hiệu Năng
# ──────────────────────────────────────────────────────────
# Số lượng tối đa item khi quét playlist/channel/profile
MAX_PLAYLIST_LIMIT=200

# Timeout (ms) cho mỗi tiến trình tải — mặc định 5 phút
DOWNLOAD_TIMEOUT_MS=300000

# ──────────────────────────────────────────────────────────
# Auth Tokens Tuỳ Chọn (để trống nếu không dùng)
# ──────────────────────────────────────────────────────────
# Pixiv: lấy refresh token tại https://github.com/eggplants/get-pixivpy-token
# PIXIV_TOKEN=your_refresh_token

# DeviantArt OAuth (đăng ký tại https://www.deviantart.com/developers/)
# DEVIANTART_CLIENT_ID=your_client_id
# DEVIANTART_CLIENT_SECRET=your_client_secret

# ──────────────────────────────────────────────────────────
# PostgreSQL Database
# ──────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
DB_DATABASE=postgres
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/postgres
