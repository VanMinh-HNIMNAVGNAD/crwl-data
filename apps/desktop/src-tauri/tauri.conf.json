{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "social-media-crawler",
  "version": "0.1.0",
  "identifier": "com.crwl.socialmedia",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Social Media Downloader",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../core": "core"
    },
    "shortDescription": "Social Media Crawler & Downloader",
    "longDescription": "Desktop App for crawling and downloading social media content",
    "category": "Utility",
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
